.card {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.25s ease;
}

.card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.cover-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: #f3eefb;
}

.grid-card .cover-wrap {
  height: 240rpx;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(43, 36, 64, 0) 0%, rgba(43, 36, 64, 0.55) 100%);
}

.cover-bottom {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scene {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 1.2;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(43, 36, 64, 0.2);
}

.likes {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

.info {
  padding: 24rpx;
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-card .title {
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #7b5bd6;
  margin-right: 16rpx;
  white-space: nowrap;
}
