<view class="card" bindtap="handleTap">
  <view class="image-wrap">
    <image class="image" src="{{item.image}}" mode="aspectFill" binderror="handleImageError" />
    <view class="badge">
      <text class="badge-text">{{categoryLabel}}</text>
    </view>
    <view class="fav-btn" catchtap="handleFavorite">
      <view class="fav-icon mw-icon {{item.favorite ? 'mw-icon-heart-fill fav-icon-active' : 'mw-icon-heart'}}"></view>
    </view>
    <view class="syncBadge" wx:if="{{item.syncState === 'pending'}}">
      <text class="syncBadgeText">未同步</text>
    </view>
  </view>
  <view class="info">
    <text class="name">{{item.name}}</text>
    <view class="meta-row">
      <view class="color-dot" style="background-color: {{item.colorHex}}"></view>
      <text class="color-name">{{item.color}}</text>
    </view>
  </view>
</view>
