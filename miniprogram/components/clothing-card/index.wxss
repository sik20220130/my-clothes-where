.card {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.25s ease;
}

.card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.image-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #f3eefb;
}

.image {
  width: 100%;
  height: 100%;
  display: block;
}

.badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
}

.badge-text {
  font-size: 22rpx;
  color: #7b5bd6;
  font-weight: 500;
}

.fav-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-btn:active {
  opacity: 0.8;
  transform: scale(0.94);
}

.fav-icon {
  font-size: 30rpx;
  line-height: 1;
}

.info {
  padding: 24rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ede8f7;
  flex-shrink: 0;
}

.color-name {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #9c95b0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-icon{color:#c4bed3;font-size:34rpx;line-height:1;}
.fav-icon-active{color:#ff6f91;}

.syncBadge {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(43, 36, 64, 0.72);
}

.syncBadgeText {
  font-size: 20rpx;
  color: #ffffff;
  white-space: nowrap;
}
