.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
  width: 100%;
}

.illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
  border-radius: 999rpx;
  background: #f7f3ff;
}

.illustrationArt {
  width: 192rpx;
  height: 192rpx;
  background-color: #7b5bd6;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.illustrationArt-home-empty {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.illustrationArt-wardrobe-empty {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.illustrationArt-search-empty {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.illustrationArt-outfit-empty {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.illustrationArt-item-missing {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2f2a3d;
  text-align: center;
}

.description {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9c95b0;
  text-align: center;
  line-height: 1.8;
}

.action {
  margin-top: 32rpx;
  min-width: 240rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.action:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  white-space: nowrap;
}
