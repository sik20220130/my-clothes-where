<view class="header">
  <view class="left">
    <text class="title">{{title}}</text>
    <text class="subtitle" wx:if="{{subtitle}}">{{subtitle}}</text>
  </view>
  <view class="extra" wx:if="{{extra}}" bindtap="handleExtra">
    <text class="extra-text">{{extra}}</text>
    <text class="arrow">›</text>
  </view>
</view>
