<view class="page">
  <view class="header">
    <view class="statRow">
      <text class="statText">{{filtered.length}} 件单品 · {{wardrobes.length}} 个衣橱</text>
      <view class="manage" bindtap="goManage">
        <text class="manageText">衣橱管理</text>
        <text class="manageArrow">›</text>
      </view>
    </view>

    <scroll-view class="cabinetScroll" scroll-x>
      <view
        class="cabinetCard allCard {{activeCabinet === 'all' ? 'cabinetCardActive' : ''}}"
        data-id="all"
        bindtap="selectCabinet"
      >
        <view class="allContent">
          <text class="allTitle">全部衣橱</text>
          <text class="allSub">{{items.length}} 件单品</text>
        </view>
      </view>
      <view
        class="cabinetCard {{activeCabinet === item.id ? 'cabinetCardActive' : ''}}"
        wx:for="{{wardrobes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectCabinet"
      >
        <image class="cabinetCover" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
        <image class="cabinetCover" wx:else src="/assets/wardrobe/default-cover.png" mode="aspectFill" />
        <view class="cabinetMask"></view>
        <view class="cabinetContent">
          <text class="cabinetTitle">{{item.name}}</text>
          <text class="cabinetSub">{{item.count}} 件</text>
        </view>
      </view>
    </scroll-view>

    <view class="searchWrap">
      <view class="searchIcon"></view>
      <input
        class="searchInput"
        value="{{keyword}}"
        placeholder="搜索单品名称 / 颜色 / 品牌"
        placeholder-class="searchPlaceholder"
        confirm-type="search"
        bindinput="handleSearch"
      />
      <view class="favFilter {{favoriteOnly ? 'favFilterActive' : ''}}" catchtap="toggleFavoriteFilter">
        <view class="favFilterIcon mw-icon {{favoriteOnly ? 'mw-icon-heart-fill' : 'mw-icon-heart'}}"></view>
      </view>
    </view>

    <scroll-view class="chips" scroll-x>
      <view
        class="chip {{activeCategory === item.key ? 'chipActive' : ''}}"
        wx:for="{{categoryList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="selectCategory"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <view class="summary">
    <text class="summaryText" wx:if="{{favoriteOnly}}">仅看喜欢的单品 · {{filtered.length}} 件</text>
    <text class="summaryText" wx:else>{{filtered.length}} 件单品</text>
    <text class="clearText" wx:if="{{hasFilter}}" bindtap="resetFilter">清除筛选</text>
  </view>

  <view class="grid" wx:if="{{filtered.length > 0}}">
    <view class="gridItem" wx:for="{{filtered}}" wx:key="id">
      <clothing-card
        item="{{item}}"
        bind:select="goDetail"
        bind:favorite="handleFavorite"
      />
    </view>
  </view>

  <block wx:else>
    <empty-state
      wx:if="{{items.length === 0}}"
      illustration="wardrobe-empty"
      title="衣橱还是空的"
      description="拍下第一件衣服，开始建立你的数字衣橱。"
      action-text="添加第一件单品"
      bind:action="goAdd"
    />

    <empty-state
      wx:elif="{{favoriteOnly}}"
      illustration="search-empty"
      title="还没有喜欢的单品"
      description="在单品详情点爱心即可标记"
      action-text="查看全部"
      bind:action="resetFilter"
    />

    <empty-state
      wx:else
      illustration="search-empty"
      title="没有找到相关单品"
      description="试试更换关键词、品类或衣橱筛选"
      action-text="清除筛选"
      bind:action="resetFilter"
    />

    <view class="sampleBtn" wx:if="{{items.length === 0}}" bindtap="handleLoadSample">
      <text class="sampleBtnText">载入示例数据</text>
    </view>
  </block>

  <view class="fab" bindtap="goAdd">
    <text class="fabText">+</text>
  </view>
</view>
