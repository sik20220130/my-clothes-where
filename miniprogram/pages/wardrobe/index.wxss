.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 220rpx;
  background: #f7f4fc;
}

.header {
  display: flex;
  flex-direction: column;
}

.statRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.statText {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: #9c95b0;
}

.manage {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 8rpx 0 8rpx 16rpx;
}
.manage:active {
  opacity: 0.85;
}

.manageText {
  font-size: 24rpx;
  color: #7b5bd6;
  white-space: nowrap;
}

.manageArrow {
  margin-left: 4rpx;
  font-size: 26rpx;
  line-height: 1;
  color: #7b5bd6;
}

.cabinetScroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.cabinetCard {
  display: inline-block;
  width: 260rpx;
  vertical-align: top;
  white-space: normal;
  position: relative;
  height: 152rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3eefb;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.cabinetCardActive {
  border-color: #7b5bd6;
}

.cabinetCover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cabinetMask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(43, 36, 64, 0.05) 0%, rgba(43, 36, 64, 0.6) 100%);
}

.cabinetContent {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 14rpx;
}

.cabinetTitle {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cabinetSub {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.allCard {
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.allContent {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 14rpx;
}

.allTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.allSub {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.searchWrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.searchIcon {
  font-size: 28rpx;
  line-height: 1;
}

.searchInput {
  flex: 1;
  height: 88rpx;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #2b2440;
}

.favFilter {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.favFilter:active {
  opacity: 0.75;
}

.favFilterIcon {
  width: 40rpx;
  height: 40rpx;
  color: #9c95b0;
}

.favFilterActive .favFilterIcon {
  color: #7b5bd6;
}

.searchPlaceholder {
  color: #9c95b0;
  font-size: 24rpx;
}

.chips {
  margin-top: 24rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  width: 132rpx;
  vertical-align: top;
  white-space: normal;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b6480;
  background: #ffffff;
  border-radius: 48rpx;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.chip:active {
  opacity: 0.85;
}

.chipActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 16rpx;
}

.summaryText {
  font-size: 24rpx;
  color: #9c95b0;
}

.clearText {
  font-size: 24rpx;
  color: #7b5bd6;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.gridItem {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  box-shadow: 0 8rpx 24rpx rgba(123, 91, 214, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.25s ease;
}
.fab:active {
  opacity: 0.9;
  transform: scale(0.94);
}

.fabText {
  font-size: 56rpx;
  line-height: 1;
  color: #ffffff;
  margin-top: -6rpx;
}

.searchIcon{position:relative;width:32rpx;height:32rpx;margin-right:12rpx;flex-shrink:0;font-size:0;}
.searchIcon::before{content:"";position:absolute;left:1rpx;top:1rpx;width:21rpx;height:21rpx;border:3rpx solid #a79ec0;border-radius:50%;box-sizing:border-box;}
.searchIcon::after{content:"";position:absolute;right:2rpx;bottom:3rpx;width:11rpx;height:3rpx;border-radius:3rpx;background:#a79ec0;transform:rotate(45deg);}

.sampleBtn {
  width: 280rpx;
  height: 72rpx;
  margin: -48rpx auto 64rpx;
  border-radius: 48rpx;
  border: 2rpx dashed #7b5bd6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sampleBtn:active {
  opacity: 0.8;
}
.sampleBtnText {
  font-size: 24rpx;
  color: #7b5bd6;
}
