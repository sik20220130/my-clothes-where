.page {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background: #f7f4fc;
}

.cover {
  width: 100%;
  height: 560rpx;
  display: block;
  background: #f3eefb;
}

.content {
  position: relative;
  margin-top: -60rpx;
  padding: 0 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.sceneBadge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f3eefb;
}

.sceneText {
  font-size: 22rpx;
  color: #7b5bd6;
  white-space: nowrap;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2b2440;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.author {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9c95b0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #7b5bd6;
}

.sectionTitle {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.description {
  display: block;
  font-size: 28rpx;
  color: #6b6480;
  line-height: 1.8;
}

.itemRow {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f0fb;
}
.itemRow:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.itemIndex {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #f3eefb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.itemIndexText {
  font-size: 22rpx;
  color: #7b5bd6;
  font-weight: 600;
}

.itemName {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.itemThumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f3eefb;
  flex-shrink: 0;
}

.itemThumbMissing {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d9d3e8;
  background: #f7f4fc;
}

.itemMissingMark {
  font-size: 28rpx;
  color: #c9c3d8;
}

.itemNameMissing {
  color: #9c95b0;
}

.actionBar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(43, 36, 64, 0.06);
  z-index: 20;
}

.actionBtn {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.actionBtn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.ghostBtn {
  margin-right: 20rpx;
  background: #f3eefb;
}

.ghostText {
  font-size: 30rpx;
  font-weight: 600;
  color: #7b5bd6;
}

.dangerBtn {
  background: #fdecec;
}

.dangerText {
  font-size: 30rpx;
  font-weight: 600;
  color: #f53f3f;
}
