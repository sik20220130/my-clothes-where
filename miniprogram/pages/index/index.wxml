<view class="page">
  <view class="header">
    <view class="topRow">
      <view class="greetWrap">
        <text class="greeting">{{greeting}}，欢迎回来</text>
        <text class="subText">{{todayText}} · 今天也要好好打扮</text>
      </view>
      <view class="avatarWrap" bindtap="goMine">
        <image class="avatar" src="{{avatar}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <view class="body">
    <view class="quickCard">
      <view
        class="quickItem"
        wx:for="{{quickEntries}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="handleQuickEntry"
      >
        <view class="quickEmojiWrap">
          <view class="quickIcon mw-icon mw-icon-{{item.icon}}"></view>
        </view>
        <text class="quickLabel">{{item.label}}</text>
      </view>
    </view>

    <view class="statsCard">
      <view class="statItem">
        <text class="statValue">{{stats.total}}</text>
        <text class="statLabel">衣橱单品</text>
      </view>
      <view class="statDivider"></view>
      <view class="statItem">
        <text class="statValue">{{stats.monthly}}</text>
        <text class="statLabel">本月新增</text>
      </view>
      <view class="statDivider"></view>
      <view class="statItem">
        <text class="statValue">{{stats.wardrobeCount}}</text>
        <text class="statLabel">衣橱数量</text>
      </view>
    </view>

    <view class="recentSection" wx:if="{{!isEmpty}}">
      <view class="recentHeader">
        <text class="recentTitle">最近添加</text>
        <text class="recentMore" bindtap="goWardrobe">查看全部 ›</text>
      </view>
      <scroll-view class="recentScroll" scroll-x>
        <view
          class="recentCard"
          wx:for="{{recentItems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goItemDetail"
        >
          <image class="recentImage" src="{{item.image}}" mode="aspectFill" />
          <text class="recentName">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <empty-state
      wx:if="{{isEmpty}}"
      emoji="🪄"
      title="欢迎来到你的数字衣橱"
      description="先添加几件衣服，首页会显示本月新增与常用入口。"
      action-text="开始添加"
      bind:action="goAdd"
    />
  </view>
</view>
