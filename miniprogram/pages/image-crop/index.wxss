.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #0f0a1e;
}

.topBar {
  display: flex;
  align-items: center;
  height: 44px;
  padding-left: 16px;
  padding-right: 16px;
  box-sizing: content-box;
  flex-shrink: 0;
}

.cancelBtn {
  display: flex;
  align-items: center;
  height: 44px;
  min-width: 64px;
}

.cancelBtn:active {
  opacity: 0.7;
}

.cancelIcon {
  font-size: 15px;
  color: #ffffff;
}

.cancelText {
  margin-left: 6px;
  font-size: 15px;
  color: #ffffff;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
}

.navSpacer {
  height: 44px;
  flex-shrink: 0;
}

.stage {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #000000;
  flex-shrink: 0;
}

.canvas {
  position: absolute;
  left: 0;
  top: 0;
}

.loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  display: flex;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.loadingText {
  padding: 10px 18px;
  border-radius: 40px;
  background: rgba(0, 0, 0, 0.55);
  font-size: 13px;
  color: #ffffff;
}

.bottomBar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96px;
  padding-bottom: calc(env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #0f0a1e;
  flex-shrink: 0;
}

.resetBtn {
  width: 132px;
  height: 44px;
  margin-right: 16px;
  border-radius: 44px;
  border: 1px solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.resetBtn:active {
  opacity: 0.75;
}

.resetText {
  font-size: 15px;
  color: #ffffff;
}

.confirmBtn {
  width: 168px;
  height: 44px;
  border-radius: 44px;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirmBtn:active {
  opacity: 0.85;
}

.confirmBtnDisabled {
  opacity: 0.4;
}

.confirmText {
  font-size: 15px;
  font-weight: 600;
  color: #7b5bd6;
}
