<view class="page">
  <view class="topBar" style="padding-top: {{statusBarHeight}}px;">
    <view class="cancelBtn" bindtap="handleCancel">
      <view class="cancelIcon mw-icon mw-icon-close"></view>
      <text class="cancelText">取消</text>
    </view>
    <text class="title">裁切</text>
    <view class="navSpacer" style="width: {{navRight}}px;"></view>
  </view>

  <view
    class="stage"
    style="height: {{stageHeight}}px;"
    bindtouchstart="handleTouchStart"
    catchtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchEnd"
  >
    <canvas
      type="2d"
      id="cropCanvas"
      class="canvas"
      style="width: {{stageWidth}}px; height: {{stageHeight}}px;"
      disable-scroll="true"
    ></canvas>
    <view class="loading" wx:if="{{!loaded && !error}}">
      <text class="loadingText">图片加载中…</text>
    </view>
    <view class="loading" wx:if="{{error}}">
      <text class="loadingText">{{error}}</text>
    </view>
  </view>

  <view class="bottomBar">
    <view class="resetBtn" bindtap="handleReset">
      <text class="resetText">重置</text>
    </view>
    <view class="confirmBtn {{loaded ? '' : 'confirmBtnDisabled'}}" bindtap="handleConfirm">
      <text class="confirmText">确认</text>
    </view>
  </view>
</view>
