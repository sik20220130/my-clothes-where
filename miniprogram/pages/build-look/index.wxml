<view class="page">
  <view class="boardCard">
    <view class="boardHeader">
      <text class="boardTitle">搭配画板</text>
      <text class="boardCount">已选 {{selectedCount}} 件</text>
    </view>

    <view class="slots">
      <view class="slot" wx:for="{{boardSlots}}" wx:key="key">
        <view
          class="slotBox {{item.image ? 'slotBoxFilled' : ''}}"
          data-key="{{item.key}}"
          bindtap="handleSlotTap"
        >
          <image class="slotImage" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
          <view class="slotIcon mw-icon mw-icon-{{item.icon}}" wx:else></view>
        </view>
        <text class="slotLabel {{activeSlot === item.key ? 'slotLabelActive' : ''}}">{{item.label}}</text>
      </view>
    </view>

    <input
      class="nameInput"
      value="{{lookName}}"
      maxlength="16"
      placeholder="给这套搭配起个名字（选填）"
      placeholder-class="placeholder"
      bindinput="handleNameInput"
    />
  </view>

  <scroll-view class="slotTabs" scroll-x>
    <view
      class="slotTab {{activeSlot === item.key ? 'slotTabActive' : ''}}"
      wx:for="{{slots}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="selectSlotTab"
    >
      <view class="slotTabIcon mw-icon mw-icon-{{item.icon}}"></view>
      <text class="slotTabText">{{item.label}}</text>
    </view>
  </scroll-view>

  <view class="picker" wx:if="{{pickerItems.length > 0}}">
    <view
      class="pickerItem {{item.active ? 'pickerItemActive' : ''}}"
      wx:for="{{pickerItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="handlePickerSelect"
    >
      <image class="pickerImage" src="{{item.image}}" mode="aspectFill" />
      <text class="pickerName">{{item.name}}</text>
      <view class="checkBadge" wx:if="{{item.active}}">
        <view class="checkIcon mw-icon mw-icon-check"></view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="emptyText">这个分类还没有单品，去衣橱添加吧</text>
  </view>

  <view class="saveBar">
    <view class="saveBtn {{saveDisabled ? 'saveBtnDisabled' : ''}}" bindtap="handleSave">
      <text class="saveText">保存这套搭配</text>
    </view>
  </view>
</view>
