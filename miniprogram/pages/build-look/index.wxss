.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 240rpx;
  background: #f7f4fc;
}

.boardCard {
  margin-top: 0;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.boardHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.boardTitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2440;
}

.boardCount {
  font-size: 24rpx;
  color: #7b5bd6;
}

.slots {
  display: flex;
  margin-top: 32rpx;
}

.slot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
}
.slot:last-child {
  margin-right: 0;
}

.slotBox {
  width: 100%;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f7f4fc;
  border: 2rpx dashed #ede8f7;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.15s ease;
}
.slotBox:active {
  opacity: 0.85;
}

.slotBoxFilled {
  border-color: transparent;
  background: #f3eefb;
}

.slotImage {
  width: 100%;
  height: 100%;
  display: block;
}

.slotIcon {
  width: 56rpx;
  height: 56rpx;
  color: #7b5bd6;
  opacity: 0.55;
}

.slotLabel {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c95b0;
  white-space: nowrap;
}

.slotLabelActive {
  color: #7b5bd6;
  font-weight: 600;
}

.nameInput {
  width: 100%;
  height: 80rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  background: #f7f4fc;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #2b2440;
  box-sizing: border-box;
}

.placeholder {
  color: #9c95b0;
  font-size: 24rpx;
}

.slotTabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.slotTab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 170rpx;
  vertical-align: top;
  height: 64rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #6b6480;
  background: #ffffff;
  border-radius: 48rpx;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.slotTab:active {
  opacity: 0.85;
}

.slotTabIcon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  color: #9c95b0;
}

.slotTabActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.slotTabActive .slotTabIcon {
  color: #ffffff;
}

.picker {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}

.pickerItem {
  position: relative;
  width: calc(33.33% - 10rpx);
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
}
.pickerItem:active {
  opacity: 0.9;
}

.pickerItemActive {
  border-color: #7b5bd6;
}

.pickerImage {
  width: 100%;
  height: 190rpx;
  display: block;
  background: #f3eefb;
}

.pickerName {
  display: block;
  padding: 10rpx 12rpx;
  font-size: 22rpx;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkBadge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #7b5bd6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkIcon {
  width: 24rpx;
  height: 24rpx;
  color: #ffffff;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.emptyText {
  font-size: 24rpx;
  color: #9c95b0;
}

.saveBar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(43, 36, 64, 0.06);
  z-index: 20;
}

.saveBtn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.saveBtn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.saveBtnDisabled {
  opacity: 0.45;
}

.saveText {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
}
