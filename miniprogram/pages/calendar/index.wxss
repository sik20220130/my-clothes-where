.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  background: #f7f4fc;
}

.header {
  padding: 8rpx 8rpx 0;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2b2440;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9c95b0;
}

.group {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dateRow {
  display: flex;
  align-items: center;
}

.dateDot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #7b5bd6;
  box-shadow: 0 0 0 6rpx rgba(123, 91, 214, 0.12);
}

.dateText {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.weekText {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.countText {
  margin-left: auto;
  font-size: 22rpx;
  color: #7b5bd6;
}

.items {
  margin-top: 16rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f4f0fb;
}

.item:active {
  opacity: 0.85;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: #f3eefb;
  flex-shrink: 0;
}

.itemInfo {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.itemName {
  display: block;
  font-size: 26rpx;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.itemMeta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.itemFav {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  color: #7b5bd6;
}
