<view class="page">
  <view class="header">
    <text class="title">我的搭配</text>
    <text class="subtitle">整理日常穿搭，随时回看</text>
  </view>

  <view class="looksSection">
    <view class="looksHeader">
      <text class="looksTitle">我的搭配</text>
      <text class="looksMore" bindtap="goBuildLook">去搭配 ›</text>
    </view>

    <scroll-view class="lookScroll" scroll-x wx:if="{{lookCards.length > 0}}">
      <view class="createCard" bindtap="goBuildLook">
        <text class="createIcon">＋</text>
        <text class="createText">新建搭配</text>
      </view>
      <view
        class="lookCard"
        wx:for="{{lookCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goLook"
      >
        <view class="lookImages">
          <image
            class="lookImage"
            wx:for="{{item.images}}"
            wx:for-item="image"
            wx:key="*this"
            src="{{image}}"
            mode="aspectFill"
          />
        </view>
        <view class="lookFooter">
          <text class="lookName">{{item.name}}</text>
          <text class="lookDelete" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="handleRemoveLook">删除</text>
        </view>
      </view>
    </scroll-view>

    <empty-state
      wx:else
      emoji="🎨"
      title="还没有搭配"
      description="先收纳至少 2 件单品，再把它们组合成一套搭配。"
      action-text="去添加单品"
      bind:action="goAdd"
    />
  </view>
</view>
