.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  background: #f7f4fc;
}

.magicBanner {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 60%, #ffa9be 100%);
  box-shadow: 0 8rpx 24rpx rgba(123, 91, 214, 0.28);
}

.looksHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.looksTitle {
  font-size: 36rpx;
  font-weight: 600;
  color: #2f2a3d;
}

.looksMore {
  font-size: 24rpx;
  color: #7b5bd6;
}

.lookScroll {
  white-space: nowrap;
}

.createCard {
  display: inline-block;
  width: 220rpx;
  vertical-align: top;
  white-space: normal;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 210rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #7b5bd6;
  background: #ffffff;
  transition: all 0.15s ease;
}
.createCard:active {
  opacity: 0.85;
}

.createIcon {
  font-size: 44rpx;
  color: #7b5bd6;
  line-height: 1;
}

.createText {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.lookCard {
  display: inline-block;
  width: 320rpx;
  vertical-align: top;
  white-space: normal;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.lookImages {
  display: flex;
  height: 150rpx;
  background: #f3eefb;
}

.lookImage {
  width: 33.33%;
  height: 100%;
  display: block;
}

.lookFooter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx;
}

.lookName {
  flex: 1;
  font-size: 22rpx;
  font-weight: 500;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lookDelete {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #f53f3f;
}

.magicBannerText {
  flex: 1;
  min-width: 0;
}

.magicTitleRow {
  display: flex;
  align-items: center;
}

.magicTitleIcon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.magicTitle {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.magicDesc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.magicBtn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 32rpx;
  margin-left: 24rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.magicBtn:active {
  opacity: 0.88;
  transform: scale(0.97);
}

.magicBtnText {
  font-size: 24rpx;
  font-weight: 600;
  color: #7b5bd6;
  white-space: nowrap;
}

.magicResult {
  margin-top: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.magicResultHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.magicResultTitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.magicRefresh {
  font-size: 24rpx;
  color: #7b5bd6;
}

.magicList {
  display: flex;
  margin-top: 24rpx;
}

.magicItem {
  flex: 1;
  margin-right: 16rpx;
  transition: all 0.25s ease;
}
.magicItem:last-child {
  margin-right: 0;
}
.magicItem:active {
  opacity: 0.88;
}

.magicImage {
  width: 100%;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f3eefb;
}

.magicName {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.magicCategory {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.chips {
  margin-top: 24rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  width: 112rpx;
  vertical-align: top;
  white-space: normal;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b6480;
  background: #ffffff;
  border-radius: 48rpx;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.chip:active {
  opacity: 0.85;
}

.chipActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.list {
  margin-top: 24rpx;
}

.listItem {
  margin-bottom: 24rpx;
}

