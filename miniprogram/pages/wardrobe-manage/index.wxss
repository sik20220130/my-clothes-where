.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  background: #f7f4fc;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2b2440;
  line-height: 1.3;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9c95b0;
}

.addBtn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.addBtn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.addBtnText {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  white-space: nowrap;
}

.list {
  margin-top: 24rpx;
}

.card {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f3eefb;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.nameRow {
  display: flex;
  align-items: center;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2440;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sharedBadge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 143, 168, 0.12);
}

.sharedText {
  font-size: 22rpx;
  color: #ff8fa8;
  white-space: nowrap;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.cardBottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.viewText {
  font-size: 24rpx;
  color: #7b5bd6;
}

.shareRow {
  display: flex;
  align-items: center;
}

.shareLabel {
  margin-right: 8rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.switchTrack {
  width: 84rpx;
  height: 46rpx;
  padding: 3rpx;
  border-radius: 999rpx;
  background: #ede8f7;
  display: flex;
  align-items: center;
  transition: all 0.25s ease;
}

.switchOn {
  background: #7b5bd6;
  justify-content: flex-end;
}

.switchDot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(43, 36, 64, 0.2);
}

.tipCard {
  margin-top: 16rpx;
  padding: 32rpx;
  background: #f3eefb;
  border-radius: 20rpx;
}

.tipTitle {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #7b5bd6;
}

.tipText {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b6480;
  line-height: 1.8;
}

.tipLine {
  display: block;
}
