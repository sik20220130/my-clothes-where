<view class="page">
  <view class="header">
    <text class="headerStat">共 {{wardrobes.length}} 个衣橱</text>
    <view class="addBtn" bindtap="goAdd">
      <text class="addBtnText">+ 添加衣橱</text>
    </view>
  </view>

  <view class="list">
    <view class="card" wx:for="{{wardrobes}}" wx:key="id">
      <image class="cover" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
      <image class="cover" wx:else src="/assets/wardrobe/default-cover.png" mode="aspectFill" />
      <view class="info">
        <view class="nameRow">
          <text class="name">{{item.displayName}}</text>
        </view>
        <text class="meta">{{item.location}} · {{item.count}} 件单品</text>
        <view class="cardBottom">
          <view class="actions">
            <text class="viewText" data-id="{{item.id}}" bindtap="goItems">查看单品 ›</text>
            <text class="editText" data-id="{{item.id}}" bindtap="goEdit">编辑</text>
            <text
              class="deleteText"
              data-id="{{item.id}}"
              data-name="{{item.displayName}}"
              data-count="{{item.count}}"
              bindtap="handleDelete"
            >删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tipCard">
    <text class="tipTitle">收纳小提示</text>
    <view class="tipText">
      <text class="tipLine">1. 衣橱照片支持拍照上传，真实还原家里的收纳空间</text>
      <text class="tipLine">2. 在单品详情页点击「转移衣橱」，即可把衣物移动到其他衣橱</text>
    </view>
  </view>
</view>
