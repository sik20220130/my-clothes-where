<view class="page">
  <view class="topBar" style="padding-top: {{statusBarHeight}}px; padding-right: {{skipRight}}px;">
    <text class="skip" bindtap="handleSkip">跳过</text>
  </view>

  <swiper
    class="swiper"
    current="{{current}}"
    circular="{{false}}"
    previous-margin="16rpx"
    next-margin="16rpx"
    bindchange="handleSwiperChange"
  >
    <swiper-item wx:for="{{cards}}" wx:key="page">
      <view class="card">
        <view class="mock">
          <block wx:if="{{item.type === 'home'}}">
            <view class="mockStats">
              <view class="mockStat"></view>
              <view class="mockStat"></view>
              <view class="mockStat"></view>
            </view>
            <view class="mockWide"></view>
            <view class="mockLine"></view>
            <view class="mockLine mockLineShort"></view>
          </block>
          <block wx:elif="{{item.type === 'wardrobe'}}">
            <view class="mockSearch"></view>
            <view class="mockGrid">
              <view class="mockTile"></view>
              <view class="mockTile"></view>
              <view class="mockTile"></view>
              <view class="mockTile"></view>
              <view class="mockTile"></view>
              <view class="mockTile"></view>
            </view>
          </block>
          <block wx:elif="{{item.type === 'add'}}">
            <view class="mockAdd">
              <view class="mockPhoto"></view>
              <view class="mockForm">
                <view class="mockLine"></view>
                <view class="mockLine mockLineShort"></view>
                <view class="mockChips">
                  <view class="mockChip"></view>
                  <view class="mockChip"></view>
                  <view class="mockChip"></view>
                </view>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="mockLook">
              <view class="mockSlot"></view>
              <view class="mockSlot"></view>
              <view class="mockSlot"></view>
              <view class="mockSlot"></view>
              <view class="mockSlot"></view>
            </view>
            <view class="mockLine"></view>
            <view class="mockLine mockLineShort"></view>
          </block>
        </view>

        <view class="cardBody">
          <text class="pageTag">{{item.page}}</text>
          <text class="cardTitle">{{item.title}}</text>
          <text class="cardDesc">{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="footer">
    <view class="dots">
      <view
        wx:for="{{cards}}"
        wx:key="page"
        class="dot {{index === current ? 'dotActive' : ''}}"
      ></view>
    </view>
    <view class="nextBtn" bindtap="handleNext">{{current === lastIndex ? '开始使用' : '下一步'}}</view>
  </view>
</view>
