.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 240rpx;
  background: #f7f4fc;
}

.block {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.fieldLabel {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.imagePicker {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #f7f4fc;
  border: 2rpx dashed #ede8f7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.imagePreview {
  width: 100%;
  height: 100%;
  display: block;
}

.imageEmpty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.imageEmptyIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f6f0ff, #ffeaf1);
  box-shadow: inset 0 0 0 1rpx rgba(123, 91, 214, 0.08);
}

.imageEmptyGlyph {
  width: 56rpx;
  height: 56rpx;
}

.imageEmptyText {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6b6480;
}

.imageEmptyHint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f4fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2b2440;
  box-sizing: border-box;
}

.placeholder {
  color: #9c95b0;
  font-size: 24rpx;
}

.categoryGrid {
  display: flex;
  flex-wrap: wrap;
}

.categoryChip {
  width: calc(33.33% - 11rpx);
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 16rpx 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #6b6480;
  background: #f7f4fc;
  border-radius: 12rpx;
  transition: all 0.15s ease;
}
.categoryChip:nth-child(3n) {
  margin-right: 0;
}
.categoryChip:active {
  opacity: 0.85;
}

.categoryChipActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.colorRow {
  display: flex;
  flex-wrap: wrap;
}

.colorItem {
  width: 84rpx;
  height: 84rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.colorItemActive {
  border-color: #7b5bd6;
  background: #f3eefb;
}

.colorDot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ede8f7;
}

.colorName {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9c95b0;
}

.seasonRow {
  display: flex;
  flex-wrap: wrap;
}

.seasonChip {
  width: 116rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 16rpx 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #6b6480;
  background: #f7f4fc;
  border-radius: 48rpx;
  transition: all 0.15s ease;
}
.seasonChip:active {
  opacity: 0.85;
}

.seasonChipActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.textarea {
  width: 100%;
  height: 150rpx;
  padding: 24rpx;
  background: #f7f4fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2b2440;
  box-sizing: border-box;
}

.saveBar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(43, 36, 64, 0.06);
  z-index: 20;
}

.saveBtn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.saveBtn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.saveBtnDisabled {
  opacity: 0.45;
}

.saveText {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
}

.photoActions {
  display: flex;
  margin-top: 24rpx;
}

.photoBtn {
  flex: 1;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius: 48rpx;
  background: #f3eefb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.photoBtn:last-child {
  margin-right: 0;
}
.photoBtn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.photoBtnIcon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.photoBtnText {
  font-size: 24rpx;
  color: #7b5bd6;
  font-weight: 500;
  white-space: nowrap;
}

.cabinetRow {
  display: flex;
  flex-wrap: wrap;
}

.cabinetChip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 48rpx;
  background: #f7f4fc;
  font-size: 24rpx;
  color: #6b6480;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.cabinetChip:active {
  opacity: 0.85;
}

.cabinetChipActive {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
}

.cabinetEmpty {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 48rpx;
  border: 1rpx dashed rgba(123, 91, 214, 0.4);
  background: #f9f6fe;
}

.cabinetEmptyText {
  font-size: 24rpx;
  color: #7b5bd6;
}
