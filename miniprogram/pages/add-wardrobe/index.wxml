<view class="page">
  <view class="block">
    <text class="fieldLabel">衣橱照片</text>
    <view class="imagePicker">
      <image class="imagePreview" wx:if="{{cover}}" src="{{cover}}" mode="aspectFill" />
      <view class="imageDefault" wx:else>
        <view class="imageDefaultIcon mw-icon mw-icon-hanger"></view>
        <text class="imageDefaultText">未选择封面，将使用默认封面</text>
      </view>
    </view>
    <view class="photoActions">
      <view class="photoBtn" data-source="camera" bindtap="chooseImage">
        <view class="photoBtnIcon mw-icon mw-icon-camera"></view>
        <text class="photoBtnText">拍照</text>
      </view>
      <view class="photoBtn" data-source="album" bindtap="chooseImage">
        <view class="photoBtnIcon mw-icon mw-icon-image"></view>
        <text class="photoBtnText">从相册选择</text>
      </view>
    </view>
  </view>

  <view class="block">
    <text class="fieldLabel">衣橱名称</text>
    <input
      class="input"
      value="{{name}}"
      maxlength="16"
      placeholder="例如：主卧大衣橱"
      placeholder-class="placeholder"
      bindinput="handleNameInput"
    />
  </view>

  <view class="block">
    <text class="fieldLabel">摆放位置（选填）</text>
    <input
      class="input"
      value="{{location}}"
      maxlength="20"
      placeholder="例如：主卧靠窗"
      placeholder-class="placeholder"
      bindinput="handleLocationInput"
    />
  </view>

  <view class="saveBar">
    <view class="saveBtn" bindtap="handleSave">
      <text class="saveText">{{isEdit ? '保存修改' : '创建衣橱'}}</text>
    </view>
  </view>

  <privacy-popup
    show="{{showPrivacy}}"
    bind:agree="handlePrivacyAgree"
    bind:disagree="handlePrivacyDisagree"
  />
</view>
