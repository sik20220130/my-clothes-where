.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
  background: #f7f4fc;
}

.block {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.fieldLabel {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.imagePicker {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  background: #f7f4fc;
  border: 2rpx dashed #ede8f7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.imagePreview {
  width: 100%;
  height: 100%;
  display: block;
}

.imageEmpty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.imageEmptyIcon {
  font-size: 64rpx;
  line-height: 1;
}

.imageEmptyText {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9c95b0;
}

.photoActions {
  display: flex;
  margin-top: 24rpx;
}

.photoBtn {
  flex: 1;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius: 48rpx;
  background: #f3eefb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.photoBtn:last-child {
  margin-right: 0;
}
.photoBtn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.photoBtnText {
  font-size: 24rpx;
  color: #7b5bd6;
  font-weight: 500;
  white-space: nowrap;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f4fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2b2440;
  box-sizing: border-box;
}

.placeholder {
  color: #9c95b0;
  font-size: 24rpx;
}

.shareRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shareInfo {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.shareTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2440;
}

.shareDesc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9c95b0;
  line-height: 1.5;
}

.switchTrack {
  flex-shrink: 0;
  width: 84rpx;
  height: 46rpx;
  padding: 3rpx;
  border-radius: 999rpx;
  background: #ede8f7;
  display: flex;
  align-items: center;
  transition: all 0.25s ease;
}

.switchOn {
  background: #7b5bd6;
  justify-content: flex-end;
}

.switchDot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(43, 36, 64, 0.2);
}

.saveBar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(43, 36, 64, 0.06);
  z-index: 20;
}

.saveBtn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7b5bd6 0%, #a189ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.saveBtn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.saveText {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
}

