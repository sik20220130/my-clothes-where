page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #2b2440;
  background-color: #f7f4fc;
}

page,
view,
scroll-view,
swiper,
swiper-item,
text,
image,
button,
input,
textarea,
form,
label,
navigator {
  box-sizing: border-box;
}

image {
  display: block;
}

/* 主题色线性图标（SVG 内联，无第三方依赖） */
.mw-icon {
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.mw-icon-heart {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

